#  Compilación de Rust / Cargo
# ============================================================
target/
**/*.rs.bk
Cargo.lock

# ============================================================
#  Anchor
# ============================================================
# Artefactos generados por anchor build
.anchor/
deploy/

# IDL generado (se puede regenerar con anchor build)
# Comenta la siguiente línea si quieres versionar el IDL
idl/

# ============================================================
#  Validador local de Solana
# ============================================================
test-ledger/
**/test-ledger/

