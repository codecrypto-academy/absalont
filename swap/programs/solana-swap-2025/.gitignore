# ============================================================
id.json
wallet.json
keypair.json
*.pem
*.key
*.json.bak

# ============================================================
#  Variables de entorno
# ============================================================
.env
.env.local
.env.*.local

# ============================================================
#  Editores e IDEs
# ============================================================
# VS Code
.vscode/*
!.vscode/extensions.json

# JetBrains
.idea/
*.iml

# Vim / Neovim
*.swp
*.swo
.netrwhist

# ============================================================
#  Sistema Operativo
# ============================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

